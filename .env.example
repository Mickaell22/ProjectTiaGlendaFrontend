# Configuración del API
# Solo el host: el código ya agrega el prefijo /api a cada endpoint.
# (poner /api aquí genera /api/api/... y rompe las llamadas)
VITE_API_URL=http://localhost:5000

# Configuración de Chat  
VITE_CHAT_ENABLED=true
VITE_CHAT_REFRESH_INTERVAL=30000

# Configuración de Notificaciones
VITE_NOTIFICATIONS_ENABLED=true
VITE_NOTIFICATIONS_REFRESH_INTERVAL=30000
VITE_BROWSER_NOTIFICATIONS_ENABLED=true

# Configuración de Polling
VITE_POLLING_ENABLED=true

# Configuración de Debug
VITE_DEBUG_MODE=false
